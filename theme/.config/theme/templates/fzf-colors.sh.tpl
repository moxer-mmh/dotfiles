# fzf theme — Generated by theme system (do not edit)
#
# Sourced by ~/.zshrc and by dclean. Exporting FZF_DEFAULT_OPTS means every fzf
# invocation (Ctrl-R, Ctrl-T, dclean, lazygit pickers) picks up the palette.

export FZF_DEFAULT_OPTS="
--color=bg:{{COLOR_BG}},bg+:{{COLOR_SURFACE}}
--color=fg:{{COLOR_FG_DIM}},fg+:{{COLOR_FG}}
--color=hl:{{COLOR_ACCENT}},hl+:{{COLOR_ACCENT}}
--color=info:{{COLOR_PRIMARY}},spinner:{{COLOR_PRIMARY}}
--color=prompt:{{COLOR_SECONDARY}},pointer:{{COLOR_PINK}}
--color=marker:{{COLOR_ACCENT}},header:{{COLOR_FG_DIM}}
--color=border:{{COLOR_BORDER}},label:{{COLOR_SECONDARY}}
--color=query:{{COLOR_FG}},disabled:{{COLOR_SURFACE}}
--color=gutter:{{COLOR_BG}},separator:{{COLOR_SURFACE}}
--color=scrollbar:{{COLOR_PRIMARY}},preview-border:{{COLOR_SURFACE}}
--color=preview-label:{{COLOR_ACCENT}}
--prompt='▸ '
--marker='◉ '
--pointer='▶'
--cycle
"
