# =============================================================
# mpv theme colors — auto-generated by apply-theme.sh
# Source: theme/.config/theme/templates/mpv-colors.conf.tpl
# DO NOT EDIT — changes will be overwritten on next theme apply.
#
# Pulled into the main config via `include=~~/colors.conf` in mpv.conf.
# Only genuinely theme-dependent options belong here. Subtitle colors are
# deliberately NOT themed — white-on-black is the readable choice regardless
# of palette, and tinting subtitles hurts legibility.
# =============================================================

# Fill for the area around the video / album art when the blurred backdrop
# is disabled, and for any transparent regions in the source.
background-color="{{COLOR_BG}}"

# Text OSD (volume nudges, seek messages, `o` stats overlay). uosc replaces
# most of this, but these still show for anything uosc doesn't draw.
osd-color="{{COLOR_ACCENT}}"
osd-back-color="{{COLOR_BG_ALT}}"
osd-border-color="{{COLOR_BG}}"
