#!/usr/bin/env bash
# dclean — interactive disk cleanup.
#
# Scans every known cache/junk location, then hands you an fzf checklist sorted
# by size. Nothing is deleted until you mark it and press ENTER.
#
#   dclean              interactive picker (default)
#   dclean --all        preselect everything in the SAFE tier
#   dclean --dry-run    go through the motions, delete nothing
#   dclean --list       print the scan as plain text and exit (no TUI)
#   dclean --only IDS   clean those target ids, no picker (scriptable)
#
# Keys — modal, following ~/.config/yazi/keymap.toml. Letters are motions; press
# f (or /) to search, ESC to come back. Stray keys never reach the query.
#   j k        down / up              g G      top / bottom
#   C-d C-u    half page              C-f C-b  full page
#   space      mark, move down        v V      mark one / clear marks
#   tab        mark, move down        C-a C-r  mark all / invert
#   f  /       search (ESC exits)     i ?      peek: toggle preview
#   J K        scroll the preview     s S      show safe only / show all
#   y          yank path to clipboard o        open the dir in yazi
#   enter      clean marked           q Q      quit
#
# Departures from yazi, and why: `gg` is `g` (fzf has no key chords); h/l/d/u are
# inert (no parent dir to leave, and deleting is ENTER-only here); `s` filters by
# tier instead of opening a sort menu, since the list is already size-ordered.
#
# Source lives in ~/dotfiles/dclean/.local/bin/. Don't edit the stowed copy.
#
# Colors come from ~/.config/theme/fzf-colors.sh, generated by the theme system
# (see theme/.config/theme/templates/fzf-colors.sh.tpl). Falls back to fzf
# defaults if that file isn't there.

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# Scan cache, shared with the fzf callbacks (they re-run this script and land
# on the same path). Never a predictable name in /tmp: another local user could
# pre-create it as a symlink and have `sort >` clobber the target. Fallback is a
# directory only we can write to.
SCAN_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dclean}"
[[ -d "$SCAN_DIR" ]] || mkdir -p -m 700 "$SCAN_DIR"
SCAN_FILE="$SCAN_DIR/dclean-scan.$(id -u)"
DRY=0; PRESELECT_SAFE=0; LIST_ONLY=0

# ─── target registry ─────────────────────────────────────────────────────────
# id | tier | path | label
#
# tier drives the color and whether --all preselects it:
#   safe    — regenerates automatically, zero cost to delete
#   caution — regenerates, but costs a re-download or a slow rebuild
#   danger  — destroys something you cannot get back
#
# Plain directory targets: we delete the CONTENTS, never the directory itself,
# because several of these (Trash, go-build) misbehave if the dir disappears.
DIR_TARGETS=(
    "npx|safe|$HOME/.npm/_npx|npx package cache"
    "trash|safe|$HOME/.local/share/Trash/files|trash"
    "trash_meta|safe|$HOME/.local/share/Trash/info|trash metadata"
    "dart|safe|$HOME/.dartServer/.analysis-driver|dart analyzer cache"
    "gobuild|safe|$HOME/.cache/go-build|go build cache"
    "brave_cache|safe|$HOME/.cache/BraveSoftware|brave disk cache"
    "chrome_cache|safe|$HOME/.cache/google-chrome|chrome disk cache"
    "firefox_cache|safe|$HOME/.cache/mozilla|firefox disk cache"
    "nodegyp|safe|$HOME/.cache/node-gyp|node-gyp headers"
    "electron|safe|$HOME/.cache/electron|electron downloads"
    "thumbs|safe|$HOME/.cache/thumbnails|thumbnails"
    "spotify_cache|safe|$HOME/.cache/spotify|spotify cache"
    "oc_log|safe|$HOME/.local/share/opencode/log|opencode logs"
    "cursor_log|safe|$HOME/.config/Cursor/logs|cursor logs"
    "antigrav_log|safe|$HOME/.config/Antigravity/logs|antigravity logs"
    "discord_log|safe|$HOME/.config/discord/logs|discord logs"
    "code_log|safe|$HOME/.config/Code/logs|vscode logs"
    "gradle_daemon|safe|$HOME/.gradle/daemon|gradle daemon logs"
    "claude_cache|safe|$HOME/.cache/claude-cli-nodejs|claude cli cache"

    "yay_build|caution|$HOME/.cache/yay|AUR build dirs (src/ + pkg/)"
    "paru_build|caution|$HOME/.cache/paru|paru build dirs"
    "gradle_mod|caution|$HOME/.gradle/caches/modules-2|gradle modules"
    "gradle_bc|caution|$HOME/.gradle/caches/build-cache-1|gradle build cache"
    "playwright|caution|$HOME/.cache/ms-playwright|playwright browsers"
    "playwright_mcp|caution|$HOME/.cache/ms-playwright-mcp|playwright-mcp profiles"
    "puppeteer|caution|$HOME/.cache/puppeteer|puppeteer browsers"
    "giget|caution|$HOME/.cache/giget|giget templates"
    "precommit|caution|$HOME/.cache/pre-commit|pre-commit environments"
    "oc_snap|caution|$HOME/.local/share/opencode/snapshot|opencode session snapshots"
    "brave_sw|caution|$HOME/.config/BraveSoftware/Brave-Browser/Default/Service Worker/CacheStorage|brave service-worker cache"
)

# Targets that need a real command, not an rm. Handled in special_size/special_clean.
SPECIAL_TARGETS=(
    "pacman|safe|pacman package cache (keep last 2)"
    "aur_helper|safe|yay/paru package cache"
    "journal|safe|systemd journal (trim to 100M)"
    "coredump|safe|systemd coredumps"
    "uv|safe|uv cache (unused wheels)"
    "pip|safe|pip cache"
    "pnpm|safe|pnpm store (unreferenced)"
    "npm|safe|npm cacache"
    "bun|safe|bun package cache"
    "pkgfile|safe|pkgfile database"
    "debtap|safe|debtap cache"
    "tmpdir|safe|/tmp entries older than 3d"
    "vartmp|safe|/var/tmp older than 7d"

    "docker|caution|docker: unused images & layers"
    "orphans|caution|orphaned pacman packages"
    "pacman_all|caution|pacman cache: ALL versions (no rollback)"

    "docker_vol|danger|docker NAMED VOLUMES (data loss)"
)

# ─── plumbing ────────────────────────────────────────────────────────────────
have() { command -v "$1" >/dev/null 2>&1; }

# Bytes actually occupied on disk, for arithmetic. Missing path = 0.
#
# `--block-size=1`, NOT `-b`: -b means --apparent-size, which reports the sum of
# file lengths and undercounts what you get back. A tree of many small files
# (npx, go-build) occupies noticeably more than its apparent size once every
# file is rounded up to a block. We want the number df will move by.
#
# Also note: du exits nonzero on unreadable subdirs, and `pipefail` propagates
# that past a perfectly good grep — so validate the captured value instead of
# relying on the pipeline's exit status.
bytes_of() {
    [[ -e "$1" ]] || { echo 0; return; }
    local out
    out=$(du -s --block-size=1 "$1" 2>/dev/null | tail -1 | cut -f1)
    [[ "$out" =~ ^[0-9]+$ ]] && echo "$out" || echo 0
}
sudo_bytes_of() {
    sudo -n test -e "$1" 2>/dev/null || { echo 0; return; }
    local out
    out=$(sudo -n du -s --block-size=1 "$1" 2>/dev/null | tail -1 | cut -f1)
    [[ "$out" =~ ^[0-9]+$ ]] && echo "$out" || echo 0
}
human() { numfmt --to=iec --suffix=B --format='%.1f' "${1:-0}" 2>/dev/null || echo "${1}B"; }

field() { cut -d'|' -f"$1" <<<"$2"; }

# Look a target up in either registry. Echoes: tier|path_or_empty|label
lookup() {
    local id="$1" rec
    for rec in "${DIR_TARGETS[@]}"; do
        [[ "${rec%%|*}" == "$id" ]] && { printf '%s|%s|%s\n' \
            "$(field 2 "$rec")" "$(field 3 "$rec")" "$(field 4 "$rec")"; return; }
    done
    for rec in "${SPECIAL_TARGETS[@]}"; do
        [[ "${rec%%|*}" == "$id" ]] && { printf '%s||%s\n' \
            "$(field 2 "$rec")" "$(field 3 "$rec")"; return; }
    done
}

# ─── size probes for command-backed targets ──────────────────────────────────
special_size() {
    case "$1" in
        pacman|pacman_all) sudo_bytes_of /var/cache/pacman/pkg ;;
        aur_helper)   echo $(( $(bytes_of "$HOME/.cache/yay") + $(bytes_of "$HOME/.cache/paru") )) ;;
        journal)
            # journalctl reports e.g. "take up 48.0M"; convert to bytes, then
            # only the amount ABOVE the 100M floor is actually reclaimable.
            local u; u=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]?' | tail -1)
            local b; b=$(numfmt --from=iec "${u^^}" 2>/dev/null || echo 0)
            (( b > 104857600 )) && echo $(( b - 104857600 )) || echo 0 ;;
        coredump)     sudo_bytes_of /var/lib/systemd/coredump ;;
        uv)           bytes_of "$HOME/.cache/uv" ;;
        pip)          bytes_of "$HOME/.cache/pip" ;;
        pnpm)         bytes_of "$HOME/.local/share/pnpm/store" ;;
        npm)          bytes_of "$HOME/.npm/_cacache" ;;
        bun)          bytes_of "$HOME/.bun/install/cache" ;;
        pkgfile)      sudo_bytes_of /var/cache/pkgfile ;;
        debtap)       sudo_bytes_of /var/cache/debtap ;;
        tmpdir)       bytes_of /tmp ;;
        vartmp)       sudo_bytes_of /var/tmp ;;
        docker)
            have docker || { echo 0; return; }
            # RECLAIMABLE column of `docker system df`, summed
            local out
            out=$(sudo -n docker system df --format '{{.Reclaimable}}' 2>/dev/null \
                | grep -oE '^[0-9.]+[KMGT]?B' | sed 's/B$//' \
                | numfmt --from=iec 2>/dev/null \
                | awk '{s+=$1} END{printf "%d", s+0}')
            [[ "$out" =~ ^[0-9]+$ ]] && echo "$out" || echo 0 ;;
        docker_vol)
            have docker || { echo 0; return; }
            sudo_bytes_of /var/lib/docker/volumes ;;
        orphans)
            local o; o=$(pacman -Qtdq 2>/dev/null)
            [[ -z "$o" ]] && { echo 0; return; }
            # sum installed sizes reported by pacman, in KiB
            pacman -Qi $o 2>/dev/null | awk -F': *' '
                /^Installed Size/ {
                    v=$2; sub(/ .*/,"",v); u=$2; sub(/^[0-9.]+ /,"",u)
                    m = (u ~ /^KiB/) ? 1024 : (u ~ /^MiB/) ? 1048576 : (u ~ /^GiB/) ? 1073741824 : 1
                    s += v * m
                } END {printf "%d", s+0}' ;;
        *) echo 0 ;;
    esac
}

# ─── what each target actually does, shown in the preview pane ───────────────
special_note() {
    case "$1" in
        pacman)     echo "paccache -rk2: keeps the last 2 versions of every package so
you can still downgrade after a bad update, and drops every
cached package that is no longer installed." ;;
        pacman_all) echo "paccache -rk0: removes EVERY cached package.
You lose the ability to downgrade without re-downloading.
On a rolling release that is your only rollback path." ;;
        aur_helper) echo "yay -Sc / paru -Sc: drops cached AUR sources and the
built packages. Rebuilding means re-downloading sources." ;;
        journal)    echo "journalctl --vacuum-size=100M: trims old boot logs, keeps
the most recent 100M. You lose historical logs only." ;;
        coredump)   echo "Crash dumps written by systemd-coredump. Useful only if
you are actively debugging a crash. Otherwise dead weight." ;;
        uv)         echo "uv cache prune: removes only wheels no venv references.
Anything still in use is left alone." ;;
        pnpm)       echo "pnpm store prune: drops packages no project links to.
Safe — linked packages are untouched." ;;
        docker)     echo "docker system prune -af: removes ALL images not used by a
running container, plus build cache and stopped containers.
Named volumes are NOT touched. Next build re-pulls images." ;;
        docker_vol) echo "!! docker volume prune: deletes named volumes not attached
to a container. This is database contents, not cache.
There is no undo. Only pick this if you know what is in them." ;;
        orphans)    echo "Packages installed as dependencies that nothing needs now.
CAREFUL: this list includes things you may use directly
(ibus, qemu-*, qt5-tools) — they only look orphaned because
they arrived as deps. pacman will show the list and ask
before removing anything." ;;
        tmpdir)     echo "/tmp is a TMPFS on this machine — it lives in RAM.
Cleaning it frees memory, not disk. The df number will
not move. Only entries untouched for 3+ days are removed,
so running processes keep their scratch files." ;;
        pkgfile)    echo "pkgfile's file-to-package database. Regenerate with
'sudo pkgfile -u' whenever you next need it." ;;
        debtap)     echo "debtap's conversion cache. Rebuilt by 'sudo debtap -u'." ;;
        *)          echo "" ;;
    esac
}

dir_note() {
    case "$1" in
        npx)            echo "One full node_modules tree per 'npx <pkg>' you have ever run.
Pure junk — the next npx call re-fetches what it needs." ;;
        yay_build)      echo "yay leaves the complete build tree behind after installing:
the downloaded source, the extracted src/, and the staged
pkg/. This is what made DaVinci cost 25G instead of 7G.
Set 'yay --save --cleanafter' to stop it recurring." ;;
        brave_sw)       echo "Service-worker CacheStorage. Regenerates, but clearing it
can sign you out of PWAs and force heavy web apps to
re-download their assets. Close Brave first." ;;
        gradle_mod)     echo "Downloaded Maven/Gradle dependencies. Safe, but your next
build re-downloads all of them." ;;
        playwright|playwright_mcp|puppeteer)
                        echo "Downloaded browser binaries. Safe to remove; the next test
run re-downloads them (a few hundred MB each)." ;;
        dart)           echo "Dart analysis server cache. Rebuilt automatically the next
time you open a Flutter/Dart project." ;;
        gobuild)        echo "Go compiler cache. Rebuilt on next 'go build' — first build
after this will be slower." ;;
        trash)          echo "Files you already sent to trash. Emptying is permanent." ;;
        oc_snap)        echo "opencode's per-session file snapshots. Removing these loses
the ability to diff/restore old sessions." ;;
        precommit)      echo "pre-commit hook environments. Re-created on next commit." ;;
        *)              echo "Cache directory. Contents regenerate on demand." ;;
    esac
}

# ─── scan ────────────────────────────────────────────────────────────────────
# Writes "id|tier|bytes|label" lines, largest first. Runs the du probes in
# parallel because a cold scan of ~35 paths is otherwise painfully slow.
scan() {
    local tmp; tmp=$(mktemp)
    local rec id tier path label

    for rec in "${DIR_TARGETS[@]}"; do
        IFS='|' read -r id tier path label <<<"$rec"
        [[ -d "$path" ]] || continue
        {
            b=$(bytes_of "$path")
            (( b > 1048576 )) && printf '%s|%s|%s|%s\n' "$id" "$tier" "$b" "$label" >>"$tmp"
        } &
    done

    for rec in "${SPECIAL_TARGETS[@]}"; do
        IFS='|' read -r id tier label <<<"$rec"
        # These can neither be measured nor cleaned without root
        if (( NO_ROOT )); then
            case "$id" in
                pacman|pacman_all|journal|coredump|pkgfile|debtap|vartmp|docker|docker_vol|orphans)
                    continue ;;
            esac
        fi
        {
            b=$(special_size "$id")
            (( b > 1048576 )) && printf '%s|%s|%s|%s\n' "$id" "$tier" "$b" "$label" >>"$tmp"
        } &
    done
    wait

    sort -t'|' -k3,3nr "$tmp" >"$SCAN_FILE"
    rm -f "$tmp"
}

# ─── picker rows (re-entrant: fzf reloads by calling back into this script) ──
# Reads the cached scan, so this is instant and needs no re-measuring. Hidden id
# in field 1, rendered label in field 2 — fzf shows only field 2.
emit_rows() {
    local safe_only="${1:-0}" id tier bytes label dot
    while IFS='|' read -r id tier bytes label; do
        (( safe_only )) && [[ "$tier" != safe ]] && continue
        case "$tier" in
            safe)    dot=$'\e[32m●\e[0m' ;;
            caution) dot=$'\e[33m●\e[0m' ;;
            danger)  dot=$'\e[31m●\e[0m' ;;
        esac
        printf '%s\t%s %-38s \e[1m%9s\e[0m\n' "$id" "$dot" "$label" "$(human "$bytes")"
    done <"$SCAN_FILE"
}

# ─── preview pane (re-entrant: fzf calls back into this script) ──────────────
do_preview() {
    local id="$1" rec tier path label bytes
    rec=$(lookup "$id"); [[ -n "$rec" ]] || { echo "unknown target: $id"; return; }
    IFS='|' read -r tier path label <<<"$rec"
    bytes=$(grep "^$id|" "$SCAN_FILE" 2>/dev/null | cut -d'|' -f3)

    case "$tier" in
        safe)    printf '\e[32m● SAFE\e[0m'    ;;
        caution) printf '\e[33m● CAUTION\e[0m' ;;
        danger)  printf '\e[31m● DANGER\e[0m'  ;;
    esac
    printf '   \e[1m%s\e[0m\n' "$label"
    printf '\e[2m%s\e[0m\n\n' "$(printf '─%.0s' {1..46})"
    printf 'reclaims   \e[1m%s\e[0m\n' "$(human "${bytes:-0}")"

    if [[ -n "$path" ]]; then
        printf 'path       %s\n' "${path/#$HOME/\~}"
        local n; n=$(find "$path" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
        printf 'entries    %s\n' "$n"
        local oldest; oldest=$(find "$path" -mindepth 1 -maxdepth 1 -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort | head -1)
        [[ -n "$oldest" ]] && printf 'oldest     %s\n' "$oldest"
        printf '\n\e[2mlargest inside:\e[0m\n'
        du -xh -d1 "$path" 2>/dev/null | sort -rh | sed -n '2,7p' | sed 's/^/  /'
    fi

    local note
    note=$([[ -n "$path" ]] && dir_note "$id" || special_note "$id")
    [[ -n "$note" ]] && printf '\n\e[2m%s\e[0m\n' "$note"
}

# ─── running total in the header as you mark items ───────────────────────────
do_header_total() {
    local sum=0 id b
    for id in "$@"; do
        b=$(grep "^$id|" "$SCAN_FILE" 2>/dev/null | cut -d'|' -f3)
        sum=$(( sum + ${b:-0} ))
    done
    local keys='j/k move · space mark · f search · s safe · ? keys · enter clean · q quit'
    if (( $# == 0 )); then
        printf '%s' "$keys"
    else
        printf '%s    ▸ \e[1m%d marked · %s\e[0m' "$keys" "$#" "$(human "$sum")"
    fi
}

# ─── help overlay (? opens it, q returns — same feel as yazi's help) ──────────
do_keys() {
    local b=$'\e[1m' c=$'\e[36m' d=$'\e[2m' r=$'\e[0m'
    cat <<EOF
${b}dclean — keys${r}   ${d}modeled on ~/.config/yazi/keymap.toml${r}

${b}move${r}
  ${c}j${r} ${c}k${r}          down / up
  ${c}g${r} ${c}G${r}          top / bottom          ${d}(yazi's gg — fzf has no chords)${r}
  ${c}C-d${r} ${c}C-u${r}      half page down / up
  ${c}C-f${r} ${c}C-b${r}      full page down / up

${b}mark${r}
  ${c}space${r}        mark and move down
  ${c}tab${r}          mark and move down
  ${c}v${r}            mark just this one, stay put
  ${c}V${r}            clear every mark
  ${c}C-a${r}          mark all
  ${c}C-r${r}          invert the marks

${b}find${r}
  ${c}f${r} ${c}/${r}          search — the prompt turns into 'search ▸'
  ${c}esc${r}          leave search, back to motions
  ${c}s${r}            show only SAFE targets
  ${c}S${r}            show every target again

${b}look${r}
  ${c}i${r}            peek: toggle the preview pane
  ${c}J${r} ${c}K${r}          scroll inside the preview
  ${c}y${r}            yank the target's path to the clipboard
  ${c}o${r}            open the directory in yazi
  ${c}?${r}            this list

${b}do${r}
  ${c}enter${r}        clean everything marked  ${d}(asks first)${r}
  ${c}q${r} ${c}Q${r}          quit, change nothing

${b}tiers${r}
  ${c}●${r} safe       regenerates on its own, nothing lost
  ${c}●${r} caution    regenerates, but costs a re-download or slow rebuild
  ${c}●${r} danger     destroys something you cannot get back

${d}h l d u are intentionally inert: there is no parent directory to leave,
and the only thing that deletes here is ENTER.${r}
EOF
}

# ─── execution ───────────────────────────────────────────────────────────────
purge_contents() {
    local dir="$1"
    [[ -n "$dir" && -d "$dir" && "$dir" != "/" && "$dir" == "$HOME"/* ]] || return 1
    find "$dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
}

special_clean() {
    case "$1" in
        pacman)     sudo paccache -rk2 >/dev/null 2>&1; sudo paccache -ruk0 >/dev/null 2>&1 ;;
        pacman_all) sudo paccache -rk0 >/dev/null 2>&1; sudo paccache -ruk0 >/dev/null 2>&1 ;;
        aur_helper) have yay && yay -Sc --noconfirm >/dev/null 2>&1
                    have paru && paru -Sc --noconfirm >/dev/null 2>&1 ;;
        journal)    sudo journalctl --vacuum-size=100M >/dev/null 2>&1 ;;
        coredump)   sudo find /var/lib/systemd/coredump -mindepth 1 -delete 2>/dev/null ;;
        uv)         uv cache prune >/dev/null 2>&1 ;;
        pip)        pip cache purge >/dev/null 2>&1 ;;
        pnpm)       pnpm store prune >/dev/null 2>&1 ;;
        npm)        npm cache clean --force >/dev/null 2>&1 ;;
        bun)        bun pm cache rm >/dev/null 2>&1 ;;
        pkgfile)    sudo rm -rf /var/cache/pkgfile/* 2>/dev/null ;;
        debtap)     sudo rm -rf /var/cache/debtap/* 2>/dev/null ;;
        tmpdir)     find /tmp -mindepth 1 -maxdepth 1 -atime +3 \
                        ! -name '.X11-unix' ! -name '.XIM-unix' ! -name 'systemd-*' \
                        -user "$(id -u)" -exec rm -rf -- {} + 2>/dev/null
                    sudo systemd-tmpfiles --clean >/dev/null 2>&1 ;;
        vartmp)     sudo find /var/tmp -mindepth 1 -maxdepth 1 -atime +7 -exec rm -rf -- {} + 2>/dev/null ;;
        docker)     sudo docker system prune -af >/dev/null 2>&1 ;;
        docker_vol) sudo docker volume prune -af >/dev/null 2>&1 ;;
        orphans)
            local o; o=$(pacman -Qtdq 2>/dev/null)
            # deliberately interactive and without --noconfirm: you read the list
            [[ -n "$o" ]] && sudo pacman -Rns $o ;;
    esac
}

execute() {
    local ids=("$@") id rec tier path label before after
    before=$(df --output=avail -k / | tail -1 | tr -d ' ')

    echo
    for id in "${ids[@]}"; do
        rec=$(lookup "$id") || continue
        IFS='|' read -r tier path label <<<"$rec"
        if (( DRY )); then
            printf '  \e[33m[dry-run]\e[0m %s\n' "$label"
            continue
        fi
        printf '  \e[2m…\e[0m %s' "$label"
        if [[ -n "$path" ]]; then
            purge_contents "$path"
        else
            special_clean "$id"
        fi
        printf '\r  \e[32m✓\e[0m %s\e[K\n' "$label"
    done

    after=$(df --output=avail -k / | tail -1 | tr -d ' ')
    echo
    if (( DRY )); then
        printf '\e[1mdry-run complete\e[0m — nothing was deleted.\n'
    else
        printf '\e[1mfreed \e[32m%s\e[0m\e[1m · %s free\e[0m\n' \
            "$(human $(( (after - before) * 1024 > 0 ? (after - before) * 1024 : 0 )))" \
            "$(human $(( after * 1024 )))"
    fi
    df -h / | tail -1
}

# ─── entry points ────────────────────────────────────────────────────────────
case "${1:-}" in
    --preview)      shift; do_preview "$1"; exit 0 ;;
    --header-total) shift; do_header_total "$@"; exit 0 ;;
    --rows)         emit_rows 0; exit 0 ;;
    --rows-safe)    emit_rows 1; exit 0 ;;
    --path)         shift; cut -d'|' -f2 <<<"$(lookup "$1")"; exit 0 ;;
    --keys)         do_keys; exit 0 ;;
esac

ONLY=()
while (( $# )); do
    case "$1" in
        --dry-run|-n) DRY=1 ;;
        --all|-a)     PRESELECT_SAFE=1 ;;
        --list|-l)    LIST_ONLY=1 ;;
        --only)       shift; while (( $# )) && [[ "$1" != -* ]]; do ONLY+=("$1"); shift; done; continue ;;
        --help|-h)    sed -n '2,29p' "$SELF" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown option: $1 (try --help)" >&2; exit 2 ;;
    esac
    shift
done

(( ${#ONLY[@]} )) || have fzf || { echo "dclean: fzf is required" >&2; exit 1; }

# Warm sudo up front: several size probes need it, and prompting for a password
# from inside an fzf preview pane would wedge the UI. If there's no TTY (piped,
# cron, CI) carry on without root rather than dying — we just hide the targets
# that need it instead of listing sizes we can't measure or clean.
# Preset DCLEAN_NO_ROOT=1 to skip the password prompt entirely (user-space only).
NO_ROOT=${DCLEAN_NO_ROOT:-0}
if (( ! NO_ROOT )) && ! sudo -v; then
    NO_ROOT=1
fi
(( NO_ROOT )) && \
    printf '\e[33m! no root — skipping pacman/journal/docker/coredump targets\e[0m\n' >&2

printf '\e[2mscanning…\e[0m'
scan
total=$(awk -F'|' '{s+=$3} END{printf "%d", s+0}' "$SCAN_FILE")
count=$(wc -l <"$SCAN_FILE")
printf '\r\e[K'

(( count == 0 )) && { echo "nothing to clean — you're already tidy."; exit 0; }

# Non-interactive path: `dclean --only npx trash`. Skips the picker entirely so
# it can run from a script or a cron job.
if (( ${#ONLY[@]} )); then
    for id in "${ONLY[@]}"; do
        [[ -n "$(lookup "$id")" ]] || { echo "dclean: unknown target '$id'" >&2; exit 2; }
    done
    execute "${ONLY[@]}"
    exit 0
fi

if (( LIST_ONLY )); then
    while IFS='|' read -r id tier bytes label; do
        printf '%-8s %9s  %s\n' "$tier" "$(human "$bytes")" "$label"
    done <"$SCAN_FILE"
    printf '%-8s %9s  %s\n' '' "$(human "$total")" 'TOTAL'
    exit 0
fi

[[ -r "$HOME/.config/theme/fzf-colors.sh" ]] && . "$HOME/.config/theme/fzf-colors.sh"

preselect=()
if (( PRESELECT_SAFE )); then
    # --all means "everything safe", never caution/danger — those stay opt-in.
    preselect=(--bind "start:select-all")
    rows=$(emit_rows 1)
else
    rows=$(emit_rows 0)
fi

# ─── keys ────────────────────────────────────────────────────────────────────
# Modal, matching ~/.config/yazi/keymap.toml as closely as fzf allows: fzf starts
# --disabled (query does not filter), so plain letters are motions. `f` (yazi's
# filter) or `/` turns search on and swaps the prompt; ESC turns it back off.
#
# Two fzf facts drive the shape of this:
#
# 1. fzf has no modes and every bind is global, so `j` would type a literal "j"
#    once search is on. `transform` runs a command whose stdout is read back as
#    actions, and FZF_PROMPT is exported to it — so branching on the prompt text
#    gives a real modal edit: motion while browsing, `put()` while searching.
#
# 2. --disabled stops the query from FILTERING but not from being EDITED, so any
#    key that isn't explicitly bound still lands in the query box. Enumerating
#    every character would be endless; instead the `change` event below wipes the
#    query the instant it changes while in normal mode. One bind, total coverage.
NORMAL_PROMPT='clean ▸ '
SEARCH_PROMPT='search ▸ '

# `?` opens the key list full-screen via execute(), which suspends the TUI and
# gives the child the real terminal. A pager means q returns to the list, the
# same way yazi's help overlay closes.
if have less; then
    PAGER_CMD="less -R --no-init --quit-on-intr"
else
    PAGER_CMD="cat; read -rsn1 -p 'press any key…'"
fi

# key → action while in normal mode; types the character while searching
motion() {
    printf -- '--bind\n%s:transform:[[ $FZF_PROMPT == *search* ]] && echo "put(%s)" || echo "%s"\n' \
        "$1" "$1" "$2"
}
mapfile -t MOTIONS < <(
    # movement — yazi: j/k arrow, gg/G top/bottom (fzf has no key chords, so g)
    motion j 'down'
    motion k 'up'
    motion g 'first'
    motion G 'last'
    # yazi binds h to "leave" and l to "enter"; neither exists in a flat list,
    # so they are inert rather than surprising
    motion h 'ignore'
    motion l 'ignore'
    # selection — yazi: space toggle, v visual, V exit visual
    motion v 'toggle'
    motion V 'deselect-all'
    # preview — yazi peeks with i
    motion i 'toggle-preview'
    motion J 'preview-down'
    motion K 'preview-up'
    # dclean-specific: tier filter. yazi uses s for its sort menu; there is
    # nothing to sort here (the list is already size-ordered), so s reuses the key
    motion s "reload($SELF --rows-safe)"
    motion S "reload($SELF --rows)"
    # quit — yazi: q / Q
    motion q 'abort'
    motion Q 'abort'
    # yazi's d is "remove"; here deleting is ENTER only, so d/u stay paging-free
    motion d 'ignore'
    motion u 'ignore'
)

# y yanks the target's path, like yazi. Wayland box, so wl-copy.
if have wl-copy; then
    mapfile -t -O "${#MOTIONS[@]}" MOTIONS < <(
        motion y "execute-silent($SELF --path {1} | wl-copy)+bell"
    )
fi
# o opens the directory in yazi itself, to look before you delete
if have yazi; then
    mapfile -t -O "${#MOTIONS[@]}" MOTIONS < <(
        motion o "execute(d=\$($SELF --path {1}); [[ -d \$d ]] && yazi \"\$d\")"
    )
fi

selected=$(printf '%s\n' "$rows" | fzf \
    --ansi --multi --delimiter=$'\t' --with-nth=2 \
    --marker='◉ ' --pointer='▶' --prompt="$NORMAL_PROMPT" \
    --height=100% --layout=reverse --border=rounded \
    --border-label=" dclean · $(human "$total") reclaimable across $count targets " \
    --header="$(do_header_total)" \
    --disabled \
    "${MOTIONS[@]}" \
    --bind "multi:transform-header:$SELF --header-total {+1}" \
    --bind 'space:transform:[[ $FZF_PROMPT == *search* ]] && echo "put( )" || echo "toggle+down"' \
    --bind "f:transform:[[ \$FZF_PROMPT == *search* ]] && echo 'put(f)' || echo 'enable-search+change-prompt($SEARCH_PROMPT)'" \
    --bind "/:enable-search+change-prompt($SEARCH_PROMPT)" \
    --bind "esc:disable-search+clear-query+change-prompt($NORMAL_PROMPT)" \
    --bind 'change:transform:[[ $FZF_PROMPT == *search* ]] || echo "clear-query"' \
    --bind 'tab:toggle+down' \
    --bind 'ctrl-a:select-all' \
    --bind 'ctrl-r:toggle-all' \
    --bind "ctrl-s:reload($SELF --rows-safe)" \
    --bind 'ctrl-d:half-page-down,ctrl-u:half-page-up' \
    --bind 'ctrl-f:page-down,ctrl-b:page-up' \
    --bind "?:execute($SELF --keys | ${PAGER_CMD})" \
    --preview "$SELF --preview {1}" \
    --preview-window='right:52%:wrap:border-left' \
    "${preselect[@]}" \
    | cut -d$'\t' -f1)

[[ -z "$selected" ]] && { echo "nothing selected."; exit 0; }

mapfile -t chosen <<<"$selected"

# Confirm, with the danger tier called out explicitly.
sum=0
for id in "${chosen[@]}"; do
    b=$(grep "^$id|" "$SCAN_FILE" | cut -d'|' -f3); sum=$(( sum + ${b:-0} ))
done
printf '\n\e[1m%d targets · %s\e[0m\n' "${#chosen[@]}" "$(human "$sum")"
for id in "${chosen[@]}"; do
    rec=$(lookup "$id"); tier=$(cut -d'|' -f1 <<<"$rec")
    [[ "$tier" == "danger" ]] && printf '\e[31m  !! %s — irreversible\e[0m\n' "$(cut -d'|' -f3 <<<"$rec")"
done

if (( ! DRY )); then
    read -rp $'\nproceed? [y/N] ' ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted."; exit 0; }
fi

execute "${chosen[@]}"
